# /etc/systemd/system/triage-spooler.service  (Befund 43)
[Unit]
Description=Deliver deferred LLM triage to IRIS (custom-iris spool)
After=network-online.target wazuh-manager.service

[Service]
Type=oneshot
User=wazuh
Group=wazuh
ExecStart=/var/ossec/integrations/triage-spooler
TimeoutStartSec=2h
Nice=10
