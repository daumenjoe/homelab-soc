<group name="velociraptor,endpoint,">

  <!-- Zeilen aus dem Velociraptor-Datastore (Client-Event-Artefakt Homelab.Events.Baseline):
       neue Listening-Ports, neue authorized_keys-Eintraege, neue Cron-Zeilen. Jede Zeile traegt Host. -->
  <rule id="110180" level="2">
    <decoded_as>json</decoded_as>
    <field name="Diff">^added$</field>
    <field name="Host">\.+</field>
    <description>Velociraptor baseline change on $(Host)</description>
  </rule>

  <!-- Persistenz: neuer SSH-Key -->
  <rule id="110182" level="10">
    <if_sid>110180</if_sid>
    <field name="Line" type="pcre2">^(ssh-|ecdsa-|sk-)</field>
    <description>Velociraptor: new SSH key in $(Path) on $(Host)</description>
    <mitre><id>T1098.004</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- Persistenz: neue Cron-Zeile -->
  <rule id="110183" level="9">
    <if_sid>110180</if_sid>
    <field name="Path" type="pcre2">cron</field>
    <description>Velociraptor: new cron entry on $(Host): $(Path): $(Line)</description>
    <mitre><id>T1053.003</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- Neuer Listening-Port: Backdoor, Reverse-Shell-Listener, oder einfach ein neuer Dienst -->
  <rule id="110181" level="8">
    <if_sid>110180</if_sid>
    <field name="Port">^\d+$</field>
    <description>Velociraptor: new listening port on $(Host): $(IP):$(Port) ($(Name), pid $(Pid))</description>
    <mitre><id>T1571</id></mitre>
  </rule>
  <!-- Homelab.Events.FirewallState: Chain-Menge des nftables-Rulesets.
       Eigene Basis, weil 110180 nur Diff=added kennt und hier "removed" das
       eigentliche Signal ist. Felder: Diff, Host, Table, Chain, Rules. -->
  <rule id="110184" level="10">
    <decoded_as>json</decoded_as>
    <field name="Table">\.+</field>
    <field name="Chain">\.+</field>
    <field name="Diff" type="pcre2">^(added|removed)$</field>
    <description>Velociraptor: firewall chain $(Diff) on $(Host): $(Table)/$(Chain) ($(Rules) rules)</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_state,</group>
  </rule>

  <!-- Nur removed, gleiche Stufe - damit die Frequenzregel darunter sauber
       nur Entfernungen zaehlt. (Ein <field> in einer if_matched_sid-Regel
       prueft nur das aktuelle Event, nicht die gezaehlten; deshalb hier
       getrennt.) -->
  <rule id="110186" level="10">
    <if_sid>110184</if_sid>
    <field name="Diff">^removed$</field>
    <description>Velociraptor: firewall chain removed on $(Host): $(Table)/$(Chain)</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_state,</group>
  </rule>

  <!-- Schwall von removed = Firewall abgeschaltet/geleert (ufw disable,
       nft flush, iptables -X). 5 Chains in 2 min weg = aktiver Vorfall.
       Ergaenzt 110191 (auditd sieht den Aufruf) um den Zustand. -->
  <rule id="110185" level="12" frequency="5" timeframe="120">
    <if_matched_sid>110186</if_matched_sid>
    <same_field>Host</same_field>
    <description>T1562.004: firewall torn down on $(Host) - 5+ chains removed in 2 min</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_state,attack_in_progress,</group>
  </rule>
</group>
