<!--
  0910-defense_evasion_rules.xml
  Defense-Evasion ueber auditd-Execve (Key fw_tamper). MITRE T1562.004.
  Praefix 0910: MUSS nach 0365-auditd_rules.xml laden, damit Parent 80700
  (Audit: Messages grouped) beim Parsen bekannt ist (Befund 33).
  Felder verifiziert (live, archives.json):
    audit.key, audit.exe, audit.auid (numerisch), audit.execve.a0/a1/a2.
  Hinweis: $(agentname) expandiert in dieser Wazuh-Version (4.14.8) in
  <description> NICHT -> Host steht ohnehin im agent-Block jedes Alerts.
  auid ist numerisch (Decoder liefert keinen Klartext); 1000 = neo via passwd.
-->
<group name="audit,defense_evasion,">

  <!-- Basis: Firewall-Werkzeug aufgerufen (Key fw_tamper). Level 7 = sichtbar. -->
  <rule id="110190" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">fw_tamper</field>
    <description>T1562.004: Firewall-Werkzeug aufgerufen durch auid $(audit.auid) (exe $(audit.exe) $(audit.execve.a1))</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_tamper,</group>
  </rule>

  <!-- Eskalation: flush/disable/delete im ersten Argument = aktives Abschalten -->
  <rule id="110191" level="12">
    <if_sid>110190</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)^(flush|disable|delete)$</field>
    <description>T1562.004: Firewall geleert/abgeschaltet durch auid $(audit.auid) (nft $(audit.execve.a1) $(audit.execve.a2)) - aktiver Defense-Evasion-Versuch</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_tamper,attack_in_progress,</group>
  </rule>

  <!-- Eskalation fuer iptables-Stil: -F = flush all -->
  <rule id="110192" level="12">
    <if_sid>110190</if_sid>
    <field name="audit.execve.a1" type="pcre2">^-F$</field>
    <description>T1562.004: iptables-Flush (-F) durch auid $(audit.auid) - aktiver Defense-Evasion-Versuch</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_tamper,attack_in_progress,</group>
  </rule>

</group>
