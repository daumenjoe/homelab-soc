<!--
  0920-defense_evasion_rules.xml
  Defense-Evasion ueber auditd-Execve (Key fw_tamper). MITRE T1562.004.
  Praefix 0920: MUSS nach 0365-auditd_rules.xml laden (Parent 80700), und
  0910 ist bereits suricata. (Befund 33)
  Felder verifiziert (live): audit.key, audit.exe, audit.auid (numerisch),
  audit.execve.a0/a1/a2. $(agentname) expandiert in 4.14.8 nicht.
  auid 4294967295 = unset (kein Login, Dienst/Timer).
-->
<group name="audit,defense_evasion,">

  <!-- Stillregel ZUERST: Dienste ohne Login-Session, die nur lesen (list).
       Faengt den periodischen Velociraptor/nftables-Poll ab (Befund 34).
       flush/delete ohne Login laufen NICHT hier rein -> weiter zu 110191. -->
  <rule id="110189" level="0">
    <if_sid>80700</if_sid>
    <field name="audit.key">fw_tamper</field>
    <field name="audit.auid">^4294967295$</field>
    <field name="audit.execve.a1">^list$</field>
    <description>Firewall-Werkzeug: Dienst liest Ruleset (auid unset, nur list) - kein Alert</description>
  </rule>
  <!-- Dieselbe Stillregel fuer "nft -j list ...": a1 ist dann die Option, a2 das
       Kommando. Befund 40: Artefakt-Umbau hatte die Reihenfolge gedreht, 1.100 L7/Tag. -->
  <rule id="110188" level="0">
    <if_sid>80700</if_sid>
    <field name="audit.key">fw_tamper</field>
    <field name="audit.auid">^4294967295$</field>
    <field name="audit.execve.a1">^-j$</field>
    <field name="audit.execve.a2">^list$</field>
    <description>Firewall-Werkzeug: Dienst liest Ruleset (auid unset, -j list) - kein Alert</description>
  </rule>

  <!-- Basis: interaktiver oder nicht-lesender Firewall-Werkzeug-Aufruf. -->
  <rule id="110190" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">fw_tamper</field>
    <description>T1562.004: Firewall-Werkzeug aufgerufen durch auid $(audit.auid) (exe $(audit.exe) $(audit.execve.a1))</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_tamper,</group>
  </rule>

  <!-- Eskalation: flush/disable/delete = aktives Abschalten, egal von wem -->
  <rule id="110191" level="12">
    <if_sid>110190</if_sid>
    <field name="audit.execve.a1" type="pcre2">(?i)^(flush|disable|delete)$</field>
    <description>T1562.004: Firewall geleert/abgeschaltet durch auid $(audit.auid) (nft $(audit.execve.a1) $(audit.execve.a2)) - aktiver Defense-Evasion-Versuch</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_tamper,attack_in_progress,</group>
  </rule>

  <!-- Eskalation fuer iptables-Stil: -F = flush all -->
  <rule id="110192" level="12">
    <if_sid>110190</if_sid>
    <field name="audit.execve.a1" type="pcre2">^-F$</field>
    <description>T1562.004: iptables-Flush (-F) durch auid $(audit.auid) - aktiver Defense-Evasion-Versuch</description>
    <mitre><id>T1562.004</id></mitre>
    <group>firewall_tamper,attack_in_progress,</group>
  </rule>

</group>